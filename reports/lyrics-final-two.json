  "songs": [
    {
      "id": "song-97b815d1-3074-402d-87dc-054a26201437",
      "number": "178",
      "title": "Teacher, Do You Love Me?",
      "principalStanzaCounts": {
        "Child": 2,
        "Teacher": 2
      },
      "sections": [
        {
          "label": "Child — first stanza (first ending)",
          "text": "Teacher*, do you love me? Teacher*, will you care for me? Even if I turn away, or disobey, or go astray, Then will you love me still?"
        },
        {
          "label": "Child — second stanza (second ending)",
          "text": "Teacher*, will you teach me? Teacher*, help me choose the right. When I do not understand the Lord’s command, please take my hand And lead me safely with his light."
        },
        {
          "label": "Child — Chorus (first time)",
          "text": "I need your love, I need your light To show me how to be like Jesus. The Savior’s love will light the path To lead me safely home.",
          "disclosure": true
        },
        {
          "label": "Teacher — first response (first ending)",
          "text": "Oh yes, my child, I love you. My child, I’ll always care for you. And with the Savior as our guide, I’ll share the light I feel inside, And you will feel his love for you."
        },
        {
          "label": "Teacher — second response (second ending)",
          "text": "Oh, yes, my child, I’ll teach you. My child, I’ll help you choose the right. And when you do not understand The Lord’s command, I’ll take your hand, And he will lead us with his light."
        },
        {
          "label": "Together — Duet Chorus (second time; continue to Coda)",
          "text": "I need your love, I need your light To show me how to be like Jesus. The Savior’s love will light the path To",
          "disclosure": true
        },
        {
          "label": "Together — Coda (after Duet Chorus)",
          "text": "lead us safely home."
        },
        {
          "label": "Alternate role words (score instruction, not sung)",
          "text": "*Alternate words: Mother, Father"
        }
      ],
      "sourceEvidence": [
        "Secondary repeated-section lyrics retained separately; they do not define principal verses or chorus text.",
        "Reviewed CS178 score paths: Child row1 5–14 then row2 5–12 + second ending 15–17. First Chorus 18–26 ends at home; Oh at 26 onset 5/2 belongs to Teacher. Teacher row1 27–36 ends at you; Oh, at 36 onset 5/2 starts row2 27–34 + 37–39. Duet uses I pickup at 40, D.S. to 19–24, then coda 41–43; To at 24 joins lead us, never the first-time lead me ending. Labels identify prescribed ending paths; no artificial extra verses."
      ],
      "sourcePdf": "./assets/pdfs/fallback/song-97b815d1-3074-402d-87dc-054a26201437.pdf",
      "preservation": "Literal XML streams retained in sourceLyricStreams. Source-backed paths preserve pickups/alternative endings. CS182 uses original PDF to correct differing XML wording; source files unchanged."
    },
    {
      "id": "song-be95cf4e-2b13-4a09-a71b-52ef90125517",
      "number": "182",
      "title": "How Will They Know?",
      "principalStanzaCounts": {
        "Initial stanzas": 2
      },
      "sections": [
        {
          "label": "Principal — stanza 1 (first ending)",
          "text": "How will they know, the ones for whom we care, That God is love and with us ev’rywhere, That life is good, with blessings all can share? How will they know unless we teach them so?"
        },
        {
          "label": "Principal — stanza 2 (second ending)",
          "text": "How will they learn that, though they go astray, God will forgive and help them find the way? How will they feel the Spirit day by day? How will they know unless we teach them so?"
        },
        {
          "label": "Optional descant — with stanza 2 only",
          "text": "How will they know That if they stray God will forgive and help them find the way? How will they feel the Spirit day by day? How will they know unless we teach them so?",
          "disclosure": true
        },
        {
          "label": "Later vocal section — Soprano / Alto",
          "text": "How will they grow in wisdom and delight? How will they choose to follow what is right? How can they trust the future will be bright? How will they know unless we show them? How will they live when they at last are grown? What will they give to children of their own? Will they reflect the values we have shown?"
        },
        {
          "label": "Closing parallel part — lower voice (enters first)",
          "text": "How will they know, as on through life they go?"
        },
        {
          "label": "Closing parallel part — upper voice (overlaps lower voice)",
          "text": "How will they know, as on they go?"
        },
        {
          "label": "Closing continuation — parts rejoin",
          "text": "How will they know unless we strive to teach them so?"
        }
      ],
      "sourceEvidence": [
        "Reviewed CS182 XML and original PDF pp1–4: P2 stanza1 X3–18; stanza2 pickup X19 + row2 X4–14 + common X15–16 + second ending X20–21. P1 optional descant X4–21 applies to stanza2 only; rows5/6 are not stanza numbers. Later P1 X22–49 follows. PDF p2 corrects XML grow un to grow in. PDF p4 confirms parallel lower text How will they know, as on through life they go? instead of erroneous copied opening in XML; upper know takes comma. Lower entry X50 precedes upper X51; lines overlap through X54. PDF lower pickup How will they at X54 joins common closing X55–59. All raw XML streams retained; hash guards the unchanged PDF used for these corrections."
      ],
      "sourcePdf": "./assets/pdfs/fallback/song-be95cf4e-2b13-4a09-a71b-52ef90125517.pdf",
      "preservation": "Literal XML streams retained in sourceLyricStreams. Source-backed paths preserve pickups/alternative endings. CS182 uses original PDF to correct differing XML wording; source files unchanged."
